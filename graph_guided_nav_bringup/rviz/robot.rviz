Panels:
- Class: rviz_common/Displays
  Name: Displays
  Help Height: 78
  Property Tree Widget:
    Expanded:
    - /Global Options1
    Splitter Ratio: 0.5
  Tree Height: 600
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Name: Tool Properties
  Expanded:
  - /2D Goal Pose1
  Splitter Ratio: 0.59
- Class: rviz_common/Views
  Name: Views
  Expanded:
  - /Current View1
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
    Alpha: 0.3
    Cell Size: 1
    Color: 160; 160; 164
    Line Style:
      Line Width: 0.03
      Value: Lines
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 20
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/Map
    Name: Global map
    Enabled: true
    Value: true
    Alpha: 0.8
    Color Scheme: map
    Draw Behind: true
    Topic:
      Depth: 5
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /map
      Filter size: 10
    Use Timestamp: false
  - Class: rviz_default_plugins/Map
    Name: Local map
    Enabled: true
    Value: true
    Alpha: 0.7
    Color Scheme: costmap
    Draw Behind: false
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /local_map
      Filter size: 10
    Use Timestamp: false
  - Class: rviz_default_plugins/Pose
    Name: Temporary goal
    Enabled: true
    Value: true
    Alpha: 1
    Color: 255; 140; 0
    Shape: Arrow
    Shaft Length: 0.5
    Shaft Radius: 0.041666666666666664
    Head Length: 0.16666666666666666
    Head Radius: 0.08333333333333333
    Axes Length: 0.5
    Axes Radius: 0.05
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /temp_goal_point
      Filter size: 10
  - Class: rviz_default_plugins/Pose
    Name: Final goal
    Enabled: true
    Value: true
    Alpha: 1
    Color: 255; 0; 255
    Shape: Arrow
    Shaft Length: 0.5
    Shaft Radius: 0.041666666666666664
    Head Length: 0.16666666666666666
    Head Radius: 0.08333333333333333
    Axes Length: 0.5
    Axes Radius: 0.05
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
      Filter size: 10
  - Class: rviz_default_plugins/LaserScan
    Name: Laser scan
    Enabled: true
    Value: true
    Alpha: 1
    Color: 255; 40; 40
    Color Transformer: FlatColor
    Decay Time: 0
    Style: Points
    Size (Pixels): 3
    Size (m): 0.04
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Min Color: 0; 0; 0
    Max Intensity: 0
    Min Intensity: 0
    Position Transformer: XYZ
    Selectable: true
    Use Fixed Frame: true
    Use rainbow: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /scan
      Filter size: 10
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: true
    Value: true
    Keep: 1
    Angle Tolerance: 0.1
    Position Tolerance: 0.1
    Covariance:
      Value: false
      Orientation:
        Alpha: 0.5
        Color: 255; 255; 127
        Color Style: Unique
        Frame: Local
        Offset: 1
        Scale: 1
        Value: true
      Position:
        Alpha: 0.3
        Color: 204; 51; 204
        Scale: 1
        Value: true
    Shape:
      Value: Arrow
      Alpha: 1
      Color: 255; 255; 0
      Shaft Length: 0.5
      Shaft Radius: 0.041666666666666664
      Head Length: 0.16666666666666666
      Head Radius: 0.08333333333333333
      Axes Length: 0.5
      Axes Radius: 0.05
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /odom
      Filter size: 10
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Value: true
    Frame Timeout: 15
    Frames:
      All Enabled: true
    Marker Scale: 0.5
    Show Arrows: false
    Show Axes: true
    Show Names: true
    Tree: {}
    Update Interval: 0
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetGoal
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Value: Orbit (rviz_default_plugins)
      Target Frame: base_link
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Pitch: 0.8
      Yaw: 3.9
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
    Saved:
    - Class: rviz_default_plugins/Orbit
      Name: 3D
      Value: Orbit (rviz_default_plugins)
      Target Frame: base_link
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Pitch: 0.8
      Yaw: 3.9
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
    - Class: rviz_default_plugins/TopDownOrtho
      Name: Top down
      Value: TopDownOrtho (rviz_default_plugins)
      Target Frame: base_link
      Scale: 80
      Angle: 0
      Invert Z Axis: false
      Near Clip Distance: 0.01
      X: 0
      Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Selection:
    collapsed: true
  Tool Properties:
    collapsed: true
  Views:
    collapsed: false
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1400
  Height: 900
  X: 80
  Y: 60
