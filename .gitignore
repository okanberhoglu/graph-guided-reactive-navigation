CMakeCache.txt
CMakeScripts/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake
Testing/
_deps/
CMakeUserPresets.json
compile_commands.json
cmake-build-*/

# CUDA (nvcc -keep intermediates)
*.ptx
*.cubin
*.fatbin
*.fatbin.c
*.cudafe*
*.module_id

# Ninja / Bazel
.ninja_deps
.ninja_log
build.ninja
bazel-*

