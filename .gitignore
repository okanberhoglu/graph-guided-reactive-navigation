# ---------------------------------------------------------------------------
# ROS 2 / colcon
# ---------------------------------------------------------------------------
# colcon output, in case it is ever run from inside this repo
# instead of the workspace root
build/
install/
log/

# Do NOT ignore these, they are meaningful to ROS tooling:
#   <pkg>/resource/<pkg>   (ament_python index marker)
#   COLCON_IGNORE / AMENT_IGNORE

# rosbag (ROS 1 and ROS 2)
*.bag
*.bag.active
*.db3
*.db3-shm
*.db3-wal
*.mcap
rosbag2_*/

# Qt Creator (common ROS IDE)
CMakeLists.txt.user*
*.autosave
qtcreator-*

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
ENV/
.python-version

# Packaging (ament_python with --symlink-install writes *.egg-info into src)
dist/
sdist/
wheels/
*.egg
*.egg-info/
.eggs/
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Testing, linting, type checking
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.dmypy.json
dmypy.json

# Notebooks
.ipynb_checkpoints/

